FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -e .

# Run as an unprivileged user rather than root — standard container
# hardening, limits blast radius if the container is ever compromised.
# Directories the app writes to (chroma_db, data, logs) must be owned by
# this user, since they're created fresh inside the image here and then
# overlaid by bind mounts at runtime via docker-compose.yml.
RUN useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /app/chroma_db /app/data /app/logs \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "researchmind.api.main:app", "--host", "0.0.0.0", "--port", "8000"]