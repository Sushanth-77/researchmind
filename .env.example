# Groq API key — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use for LLM inference (free tier)
GROQ_MODEL=llama-3.3-70b-versatile

# Local embedding model (downloaded via sentence-transformers, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: LangSmith tracing (free tier). Leave unset to run untraced.
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=researchmind

# Optional: Neo4j knowledge graph. Requires a local Neo4j Desktop instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Optional: protects the FastAPI backend. Leave unset to run the API
# unauthenticated (fine for local-only use). If set, every request must
# include this value in the X-API-Key header — the Streamlit frontend
# picks this up automatically from its own environment if set there too.
API_KEY=your_own_random_string_here