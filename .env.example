# Groq API key — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use for LLM inference (free tier)
GROQ_MODEL=llama-3.3-70b-versatile

# Local embedding model (downloaded via sentence-transformers, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: LangSmith tracing (free tier). Leave unset to run untraced.
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=researchmind

# Optional: Neo4j knowledge graph (Phase 11, stretch). Requires a local
# Neo4j Desktop instance running. Leave NEO4J_PASSWORD unset to skip
# knowledge-graph features entirely — nothing else in the app depends on it.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here